[Unit]
Description=Spring Boot Application
After=network.target

[Service]
User=ec2-user
WorkingDirectory={{ app_dir }}
ExecStart=/usr/bin/java -jar {{ app_dir }}/build/libs/aws-study-0.0.1-SNAPSHOT.jar \
    --spring.config.location=file:{{ app_dir }}/src/main/resources/application.properties
SuccessExitStatus=143
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target