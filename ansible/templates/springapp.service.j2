# 課題43
[Unit]
Description=Spring Boot Application
After=network.target

[Service]
User=ec2-user
WorkingDirectory={{ app_dir }}
ExecStart=/usr/bin/java -jar /home/ec2-user/aws-study/app.war \
    --spring.config.location=file:/home/ec2-user/aws-study/src/main/resources/application.properties
SuccessExitStatus=143
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target